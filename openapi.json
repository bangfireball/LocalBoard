{
  "openapi": "3.1.0",
  "info": { "title": "LocalBoard API", "version": "5.0.0", "description": "API for boards, lists, cards, labels, archives, due dates, attachments, comments, and activity. Send KANBAN_API_KEY as X-API-Key or a Bearer token when configured." },
  "servers": [{ "url": "/api/v1" }],
  "components": {
    "securitySchemes": { "ApiKey": { "type": "apiKey", "in": "header", "name": "X-API-Key" }, "Bearer": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "CardInput": { "type": "object", "properties": { "title": { "type": "string" }, "listId": { "type": "string" }, "description": { "type": "string" }, "labels": { "type": "array", "items": { "type": "string" } }, "assignee": { "type": "string" }, "dueAt": { "type": "string", "description": "Local ISO date and time" }, "dueComplete": { "type": "boolean" }, "reminderMinutes": { "type": ["integer", "null"] }, "recurrence": { "enum": ["none", "daily", "weekly", "monthly", "yearly"] }, "checklist": { "type": "array", "items": { "type": "object" } } } },
      "CommentInput": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "author": { "type": "string" } } },
      "TrelloImport": { "type": "object", "required": ["name", "lists", "cards"], "description": "A Trello board JSON export. Up to 5 MB; attachments are ignored and never fetched.", "properties": { "name": { "type": "string" }, "lists": { "type": "array", "items": { "type": "object" } }, "cards": { "type": "array", "items": { "type": "object" } }, "labels": { "type": "array", "items": { "type": "object" } }, "members": { "type": "array", "items": { "type": "object" } }, "checklists": { "type": "array", "items": { "type": "object" } }, "actions": { "type": "array", "items": { "type": "object" } } } }
    }
  },
  "security": [{ "ApiKey": [] }, { "Bearer": [] }],
  "paths": {
    "/state": { "get": { "summary": "Get an active board with lists and cards", "parameters": [{ "in": "query", "name": "boardId", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Board state" } } } },
    "/import/trello": { "post": { "summary": "Create a new board from a Trello JSON export", "description": "Maps lists, cards, labels, due completion, members, checklists, and commentCard comments with source author and timestamp. Attachments are ignored. Validation is atomic.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrelloImport" } } } }, "responses": { "201": { "description": "Created board" }, "400": { "description": "Invalid export; no board created" }, "413": { "description": "Payload exceeds 5 MB" } } } },
    "/archive": { "get": { "summary": "List archived cards and lists", "parameters": [{ "in": "query", "name": "boardId", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Archived items" } } } },
    "/boards": { "get": { "summary": "List boards", "responses": { "200": { "description": "Boards" } } }, "post": { "summary": "Create a board", "responses": { "201": { "description": "Created board" } } } },
    "/boards/{id}": { "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }], "get": { "summary": "Get a board", "responses": { "200": { "description": "Board" } } }, "patch": { "summary": "Update a board", "responses": { "200": { "description": "Updated board" } } }, "delete": { "summary": "Permanently delete a board", "responses": { "204": { "description": "Deleted" } } } },
    "/boards/{id}/labels": { "post": { "summary": "Create a board label", "responses": { "201": { "description": "Created label" } } } },
    "/boards/{id}/labels/{labelId}": { "patch": { "summary": "Update a label", "responses": { "200": { "description": "Updated label" } } }, "delete": { "summary": "Delete a label", "responses": { "204": { "description": "Deleted" } } } },
    "/lists": { "get": { "summary": "List active lists", "responses": { "200": { "description": "Lists" } } }, "post": { "summary": "Create a list", "responses": { "201": { "description": "Created list" } } } },
    "/lists/{id}": { "patch": { "summary": "Update a list", "responses": { "200": { "description": "Updated list" } } }, "delete": { "summary": "Permanently delete an empty list", "responses": { "204": { "description": "Deleted" } } } },
    "/lists/{id}/archive": { "post": { "summary": "Archive a list", "responses": { "200": { "description": "Archived list" } } } },
    "/lists/{id}/restore": { "post": { "summary": "Restore a list", "responses": { "200": { "description": "Restored list" } } } },
    "/cards": { "get": { "summary": "Search and list cards", "responses": { "200": { "description": "Cards" } } }, "post": { "summary": "Create a card", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardInput" } } } }, "responses": { "201": { "description": "Created card" } } } },
    "/cards/{id}": { "get": { "summary": "Get a card", "responses": { "200": { "description": "Card" } } }, "patch": { "summary": "Update a card", "responses": { "200": { "description": "Updated card" } } }, "delete": { "summary": "Permanently delete a card", "responses": { "204": { "description": "Deleted" } } } },
    "/cards/{id}/move": { "post": { "summary": "Move or reorder a card", "responses": { "200": { "description": "Moved card" } } } },
    "/cards/{id}/archive": { "post": { "summary": "Archive a card", "responses": { "200": { "description": "Archived card" } } } },
    "/cards/{id}/restore": { "post": { "summary": "Restore a card", "responses": { "200": { "description": "Restored card" } } } },
    "/cards/{id}/complete-due": { "post": { "summary": "Complete a due date and advance recurring dates", "responses": { "200": { "description": "Updated card" } } } },
    "/cards/{id}/attachments": { "post": { "summary": "Upload a file or attach a link", "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } } } }, "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "name": { "type": "string" } } } } } }, "responses": { "201": { "description": "Created attachment" } } } },
    "/cards/{cardId}/attachments/{attachmentId}": { "delete": { "summary": "Remove an attachment", "responses": { "204": { "description": "Removed" } } } },
    "/cards/{cardId}/attachments/{attachmentId}/download": { "get": { "summary": "Download a file attachment", "responses": { "200": { "description": "File" } } } },
    "/cards/{id}/comments": { "get": { "summary": "List card comments", "responses": { "200": { "description": "Comments" } } }, "post": { "summary": "Add a comment", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentInput" } } } }, "responses": { "201": { "description": "Created comment" } } } },
    "/cards/{cardId}/comments/{commentId}": { "patch": { "summary": "Edit a comment", "responses": { "200": { "description": "Updated comment" } } }, "delete": { "summary": "Delete a comment", "responses": { "204": { "description": "Deleted" } } } },
    "/activity": { "get": { "summary": "List durable board or card activity", "responses": { "200": { "description": "Activity entries" } } } },
    "/export": { "get": { "summary": "Export all LocalBoard data", "responses": { "200": { "description": "JSON backup" } } } }
  }
}
