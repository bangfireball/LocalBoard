{
  "openapi": "3.1.0",
  "info": { "title": "Moodle Workboard API", "version": "1.0.0", "description": "API-first Kanban control for humans, scripts, and AI agents. If KANBAN_API_KEY is configured, send it as X-API-Key or a Bearer token." },
  "servers": [{ "url": "/api/v1" }],
  "components": {
    "securitySchemes": { "ApiKey": { "type": "apiKey", "in": "header", "name": "X-API-Key" }, "Bearer": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "CardInput": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" }, "columnId": { "type": "string" }, "description": { "type": "string" }, "priority": { "enum": ["low", "medium", "high", "urgent"] }, "type": { "enum": ["feature", "bug", "maintenance", "research", "release"] }, "tags": { "type": "array", "items": { "type": "string" } }, "assignee": { "type": "string" }, "dueDate": { "type": "string", "format": "date" }, "estimate": { "type": "number" }, "moodleVersion": { "type": "string" }, "pluginName": { "type": "string" }, "trackerUrl": { "type": "string", "format": "uri" }, "checklist": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" }, "done": { "type": "boolean" } } } } } },
      "ColumnInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "color": { "type": "string" }, "wipLimit": { "type": ["integer", "null"] } } }
    }
  },
  "security": [{ "ApiKey": [] }, { "Bearer": [] }],
  "paths": {
    "/state": { "get": { "summary": "Get the complete active board", "parameters": [{ "in": "query", "name": "q", "schema": { "type": "string" } }, { "in": "query", "name": "priority", "schema": { "type": "string" } }, { "in": "query", "name": "tag", "schema": { "type": "string" } }], "responses": { "200": { "description": "Board, columns and cards" } } } },
    "/board": { "get": { "summary": "Get board metadata", "responses": { "200": { "description": "Board" } } }, "patch": { "summary": "Update board name or description", "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "Updated board" } } } },
    "/cards": { "get": { "summary": "Search and list cards", "parameters": [{ "in": "query", "name": "q", "schema": { "type": "string" } }, { "in": "query", "name": "columnId", "schema": { "type": "string" } }, { "in": "query", "name": "priority", "schema": { "type": "string" } }, { "in": "query", "name": "type", "schema": { "type": "string" } }, { "in": "query", "name": "tag", "schema": { "type": "string" } }, { "in": "query", "name": "archived", "schema": { "type": "boolean" } }], "responses": { "200": { "description": "Card list" } } }, "post": { "summary": "Create a card", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardInput" } } } }, "responses": { "201": { "description": "Created card" } } } },
    "/cards/{id}": { "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }], "get": { "summary": "Get a card", "responses": { "200": { "description": "Card" } } }, "patch": { "summary": "Update a card", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardInput" } } } }, "responses": { "200": { "description": "Updated card" } } }, "delete": { "summary": "Delete a card", "responses": { "204": { "description": "Deleted" } } } },
    "/cards/{id}/move": { "post": { "summary": "Move or reorder a card", "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["columnId"], "properties": { "columnId": { "type": "string" }, "position": { "type": "integer" } } } } } }, "responses": { "200": { "description": "Moved card" } } } },
    "/columns": { "get": { "summary": "List columns", "responses": { "200": { "description": "Columns" } } }, "post": { "summary": "Create a column", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ColumnInput" } } } }, "responses": { "201": { "description": "Created column" } } } },
    "/columns/{id}": { "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }], "patch": { "summary": "Update a column", "responses": { "200": { "description": "Updated column" } } }, "delete": { "summary": "Delete a column and move its cards", "parameters": [{ "in": "query", "name": "moveTo", "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } } },
    "/activity": { "get": { "summary": "List recent activity", "responses": { "200": { "description": "Activity" } } } },
    "/stats": { "get": { "summary": "Get board metrics", "responses": { "200": { "description": "Metrics" } } } },
    "/export": { "get": { "summary": "Export all board data", "responses": { "200": { "description": "JSON backup" } } } }
  }
}
